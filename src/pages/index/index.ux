.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 8px 8px 32px;
  background-color: #000000;
}

.top-bar {
  width: 100%;
  height: 56px;
  padding: 0px 30px;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
}

.title {
  color: #f5f5f5;
  font-size: 30px;
  font-weight: normal;
  lines: 1;
}

.settings-button {
  width: 48px;
  height: 48px;
  align-items: center;
  justify-content: center;
}

.settings-icon {
  width: 28px;
  height: 28px;
}

.empty-state {
  width: 100%;
  flex: 1;
  align-items: center;
  justify-content: center;
}

.book-list {
  width: 100%;
  height: 346px;
  margin-top: 8px;
  flex-shrink: 1;
}

.book-item {
  width: 100%;
  height: 106px;
  padding-bottom: 10px;
}

.book-card {
  width: 100%;
  height: 96px;
  padding: 0px 22px;
  border-radius: 22px;
  background-color: #262629;
  align-items: center;
}

.book-title {
  width: 100%;
  color: #f5f5f5;
  font-size: 28px;
  font-weight: normal;
  lines: 2;
  text-overflow: ellipsis;
}

.empty-text {
  color: #929292;
  font-size: 26px;
  text-align: center;
  lines: 1;
}

.bottom-space {
  width: 100%;
  height: 32px;
  flex-shrink: 0;
}
</style>
