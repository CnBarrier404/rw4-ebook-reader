<template>
  <div class="page">
    <div class="top-bar">
      <text class="title">电子书</text>
      <div class="settings-button">
        <image class="settings-icon" src="/common/settings.png"></image>
      </div>
    </div>
    <list class="book-list" if="{{books.length > 0}}">
      <list-item class="book-item" type="book" for="{{books}}">
        <div class="book-card" onclick="openBook($item)">
          <text class="book-title">{{$item.title}}</text>
        </div>
      </list-item>
    </list>
    <div class="empty-state" if="{{books.length === 0}}">
      <text class="empty-text">{{statusText}}</text>
    </div>
    <div class="bottom-space" if="{{books.length === 0}}"></div>
  </div>
</template>

<script>
import file from '@system.file'
import router from '@system.router'

export default {
  private: {
    books: [],
    statusText: '正在加载',
    loading: false
  },

  openBook(book) {
    router.push({ uri: '/pages/reader', params: { uri: book.uri, title: book.title } })
  },

  onShow() {
    if (this.loading) return
    this.loading = true
    file.list({
      // BIN installer writes to this application's mass directory.
      // The physical directory mapping still needs verification on Watch 4.
      uri: 'internal://mass/',
      success: (data) => {
        this.books = data.fileList
          .filter((entry) => entry.type !== 'dir' && /\.txt$/i.test(entry.uri))
          .map((entry) => {
            let name = entry.uri.slice(entry.uri.lastIndexOf('/') + 1)
            try {
              name = decodeURIComponent(name)
            } catch (error) {
              // Keep the original filename if it contains a literal percent.
            }
            return { uri: entry.uri, title: name.replace(/\.txt$/i, '') }
          })
        this.statusText = '暂无小说'
      },
      fail: (data, code) => {
        this.books = []
        this.statusText = '读取失败'
        console.error('Failed to list books: ' + code)
      },
      complete: () => {
        this.loading = false
      }
    })
  }
}
</script>

