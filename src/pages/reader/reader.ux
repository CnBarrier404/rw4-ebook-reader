<template>
  <div class="page">
    <div class="reading" if="{{!jumpVisible}}" onswipe="onSwipe" onclick="toggleControls">
      <text class="line" for="{{lines}}" onswipe="onSwipe">{{$item.text}}</text>
    </div>
    <div class="header" if="{{controlsVisible || jumpVisible}}">
      <text class="back header-text" onclick="goBack">&lt;</text>
      <text class="title header-text">{{title}}</text>
    </div>
    <div class="footer" if="{{!jumpVisible && (controlsVisible || status || saveError || screenError)}}" onclick="onFooter">
      <text class="status">{{status || saveError || screenError || progress}}</text>
    </div>
    <div class="jump-panel" if="{{jumpVisible}}">
      <text class="jump-label">跳转阅读进度</text>
      <text class="jump-value">{{jumpPercent}}%</text>
      <div class="jump-row">
        <div class="jump-step" onclick="adjustJump(-10)"><text class="jump-button-text">−10%</text></div>
        <div class="jump-step" onclick="adjustJump(-1)"><text class="jump-button-text">−1%</text></div>
        <div class="jump-step" onclick="adjustJump(1)"><text class="jump-button-text">+1%</text></div>
        <div class="jump-step" onclick="adjustJump(10)"><text class="jump-button-text">+10%</text></div>
      </div>
      <div class="jump-row">
        <div class="jump-action" onclick="cancelJump"><text class="jump-button-text">取消</text></div>
        <div class="jump-action" onclick="confirmJump"><text class="jump-button-text">跳转</text></div>
      </div>
    </div>
  </div>
</template>

<script>
import file from '@system.file'
import router from '@system.router'
import { asBytes, detectFormat, restoreOffset } from '../../common/reader-text'
import { PAGE_BYTES, PAGE_ROWS, makePage, previousStart } from '../../common/reader-pages'
import { marks } from '../../common/book-marks'
import { seekStart } from '../../common/reader-seek'
import { getKeepScreenOn } from '../../common/reader-settings'
import { readingScreen } from '../../common/reading-screen'

const SAVE_INTERVAL = 60000
const HISTORY_LIMIT = 64

export default {
  public: { uri: '', title: '' },
  private: { lines: Array.from({ length: PAGE_ROWS }, () => ({ text: ' ' })), status: '正在加载', saveError: '', progress: '',
    controlsVisible: false, jumpVisible: false, jumpPercent: 0, screenError: '' },
  onInit() {
    this.dead = false
    this.screenSequence = 0
    this.hidden = false
    this.loading = false
    this.current = null
    this.history = []
    this.cursor = 0
    this.cache = []
    this.failedTarget = null
    this.offset = 0
    this.saved = -1
    this.saving = -1
    this.saveSequence = 0
    this.saveTimer = 0
    this.readTimer = 0
    this.nextSaveAt = Date.now() + SAVE_INTERVAL
    this.key = 'reader.v1:' + this.uri
  },
  onReady() { this.open() },
  onShow() { this.hidden = false; this.scheduleSave(); this.applyScreenSetting() },
  onHide() { this.hidden = true; this.releaseScreen(); this.save() },
  onDestroy() {
    this.dead = true
    this.releaseScreen()
    if (this.readTimer) clearTimeout(this.readTimer)
    this.save()
    this.cache = []
    this.history = []
    this.current = null
  },
  applyScreenSetting() {
    const sequence = ++this.screenSequence
    this.screenError = ''
    getKeepScreenOn((enabled) => {
      if (this.dead || this.hidden || sequence !== this.screenSequence) return
      if (!enabled) { readingScreen.release(this); return }
      readingScreen.request(this, true, () => {
        if (!this.dead && !this.hidden && sequence === this.screenSequence) {
          this.screenError = '保持亮屏失败，点此重试'
        }
      })
    })
  },
  releaseScreen() {
    this.screenSequence++
    readingScreen.release(this)
  },
  open() {
    if (this.dead || this.loading) return
    this.loading = true
    this.status = '正在加载'
    file.get({
      uri: this.uri,
      success: (meta) => {
        if (this.dead) return
        if (!meta.length) { this.failure('书籍为空'); return }
        this.readBytes(0, Math.min(3, meta.length), (bytes) => {
          const format = detectFormat(bytes)
          meta.encoding = format.encoding
          meta.dataStart = format.dataStart
          if (meta.length <= meta.dataStart) { this.failure('书籍为空'); return }
          if (meta.encoding !== 'utf-8' && (meta.length - meta.dataStart) % 2) {
            this.failure('UTF-16 文件不完整'); return
          }
          this.meta = meta
          marks.get(this.key, (value, persisted) => {
            if (this.dead) return
            const start = restoreOffset(value, meta)
            this.saved = persisted ? start : -1
            this.loading = false
            this.loadPage({ start, mode: 'open' })
          })
        }, () => this.failure('读取失败，点此重试'))
      },
      fail: () => this.failure('无法打开书籍，点此重试')
    })
  },
  readBytes(start, length, done, failed) {
    // Complete reads can be decoded directly; allocate only for short reads.
    let buffer = null
    let filled = 0
    let requests = 0
    const request = () => {
      if (this.dead) return
      if (++requests > 8) { failed(); return }
      const retry = () => {
        if (this.dead) return
        this.readTimer = setTimeout(() => { this.readTimer = 0; request() }, 30)
      }
      file.readArrayBuffer({
        uri: this.uri, position: start + filled, length: length - filled,
        success: (data) => {
          if (this.dead) return
          let bytes
          try { bytes = asBytes(data.buffer) } catch (error) { retry(); return }
          if (!bytes.length) { retry(); return }
          const count = Math.min(bytes.length, length - filled)
          if (!buffer && count === length) {
            done(bytes.length === length ? bytes : bytes.subarray(0, length))
            return
          }
          if (!buffer) buffer = new Uint8Array(length)
          buffer.set(bytes.subarray(0, count), filled)
          filled += count
          if (filled === length) done(buffer)
          else retry()
        },
        fail: retry
      })
    }
    request()
  },
  toggleControls() {
    if (this.dead || this.hidden || this.jumpVisible) return
    this.controlsVisible = !this.controlsVisible
  },
  onSwipe(event) {
    if (this.dead || this.hidden || this.loading || this.jumpVisible || !this.current) return
    if (event.direction === 'up' || event.direction === 'down') this.controlsVisible = false
    if (event.direction === 'up') {
      if (this.current.end >= this.meta.length) { this.status = '已到书尾'; return }
      const known = this.history[this.cursor + 1]
      this.loadPage({ start: this.current.end, end: known && known.end, mode: 'next' })
    } else if (event.direction === 'down') {
      if (this.current.start <= this.meta.dataStart) { this.status = '已到书首'; return }
      const known = this.history[this.cursor - 1]
      this.loadPage(known ? { start: known.start, end: known.end, mode: 'back' } : {
        start: previousStart(this.current.start, this.meta), end: this.current.start, mode: 'previous'
      })
    }
  },
  loadPage(target) {
    if (this.dead || this.loading) return
    this.loading = true
    this.failedTarget = target
    const cached = target.mode !== 'previous' && !target.tail && this.cache.find((page) =>
      page.start === target.start && (!target.end || page.end === target.end))
    if (cached) { this.commitPage(cached, target.mode); return }
    const end = target.end || this.meta.length
    this.readBytes(target.start, Math.min(PAGE_BYTES, end - target.start), (bytes) => {
      try {
        const page = makePage(bytes, target.start, end, this.meta, target.mode === 'previous' || target.tail)
        this.commitPage(page, target.mode)
      } catch (error) {
        this.failure(error.code === 'TEXT_ENCODING' ? error.message : '分页失败，点此重试')
      }
    }, () => this.failure('读取失败，点此重试'))
  },
  commitPage(page, mode) {
    if (this.dead) return
    // Keep the observed rows stable, including when the last page is short.
    for (let i = 0; i < this.lines.length; i++) {
      const text = i < page.rows.length ? page.rows[i].text : ' '
      if (this.lines[i].text !== text) this.lines[i].text = text
    }
    const range = { start: page.start, end: page.end }
    if (mode === 'open' || mode === 'jump') { this.history = [range]; this.cursor = 0; this.cache = [] }
    else if (mode === 'back') this.cursor--
    else if (mode === 'previous') {
      this.history.unshift(range)
      if (this.history.length > HISTORY_LIMIT) this.history.pop()
      this.cursor = 0
    } else {
      this.cursor++
      this.history[this.cursor] = range
      if (this.history.length > HISTORY_LIMIT) { this.history.shift(); this.cursor-- }
    }
    this.current = page
    this.offset = page.start
    const cachedIndex = this.cache.findIndex((item) => item.start === page.start)
    if (cachedIndex >= 0) this.cache.splice(cachedIndex, 1)
    this.cache.push(page)
    if (this.cache.length > 3) this.cache.shift()
    this.loading = false
    this.failedTarget = null
    this.status = ''
    this.controlsVisible = false
    this.progress = (100 * (page.start - this.meta.dataStart) /
      (this.meta.length - this.meta.dataStart)).toFixed(2) + '%'
    this.scheduleSave()
    if (mode === 'jump') this.save()
  },
  failure(message) {
    if (this.dead) return
    this.loading = false
    this.status = message
  },
  retry() {
    if (this.loading || this.dead) return
    if (this.failedTarget && this.failedTarget.mode === 'seek') this.jumpTo(this.failedTarget.percent)
    else if (this.failedTarget) this.loadPage(this.failedTarget)
    else if (!this.current) this.open()
    else if (this.saveError) this.save()
  },
  onFooter() {
    if (this.dead || this.hidden || this.loading) return
    if (!this.controlsVisible && !this.status && !this.saveError && !this.screenError) return
    if (this.failedTarget || !this.current || this.saveError) { this.retry(); return }
    if (this.screenError) { this.applyScreenSetting(); return }
    this.jumpPercent = Math.round(100 * (this.offset - this.meta.dataStart) /
      (this.meta.length - this.meta.dataStart))
    this.jumpVisible = true
  },
  adjustJump(amount) { this.jumpPercent = Math.max(0, Math.min(100, this.jumpPercent + amount)) },
  cancelJump() { this.jumpVisible = false },
  confirmJump() {
    if (this.dead || this.hidden || this.loading || !this.current) return
    this.jumpVisible = false
    this.jumpTo(this.jumpPercent)
  },
  jumpTo(percent) {
    if (this.dead || this.loading || !this.current) return
    this.status = '正在跳转'
    if (percent === 100) {
      this.loadPage({ start: previousStart(this.meta.length, this.meta), end: this.meta.length, mode: 'jump', tail: true })
      return
    }
    const meta = this.meta
    let target = meta.dataStart + Math.floor((meta.length - meta.dataStart) * percent / 100)
    if (meta.encoding !== 'utf-8') target -= (target - meta.dataStart) % 2
    const probeStart = Math.max(meta.dataStart, target - 4)
    this.loading = true
    this.failedTarget = { mode: 'seek', percent }
    this.readBytes(probeStart, Math.min(8, meta.length - probeStart), (bytes) => {
      const start = seekStart(bytes, probeStart, target, meta)
      this.loading = false
      this.loadPage({ start, mode: 'jump' })
    }, () => this.failure('跳转失败，点此重试'))
  },
  goBack() {
    if (this.jumpVisible) { this.cancelJump(); return }
    this.hidden = true
    this.releaseScreen()
    this.save(); router.back()
  },
  scheduleSave() {
    if (this.dead || this.hidden || !this.current || this.saveTimer || this.saving >= 0 || this.saved === this.offset) return
    const delay = this.nextSaveAt - Date.now()
    if (delay <= 0) { this.save(); return }
    this.saveTimer = setTimeout(() => { this.saveTimer = 0; this.scheduleSave() }, delay)
  },
  save() {
    if (this.saveTimer) clearTimeout(this.saveTimer)
    this.saveTimer = 0
    if (!this.current || this.saving === this.offset || (this.saved === this.offset && this.saving < 0)) return
    const offset = this.offset
    const sequence = ++this.saveSequence
    this.saving = offset
    marks.set(this.key, JSON.stringify({ version: 2, encoding: this.meta.encoding,
      dataStart: this.meta.dataStart, length: this.meta.length, modified: this.meta.lastModifiedTime, offset }), (ok) => {
      if (sequence !== this.saveSequence) return
      this.saving = -1
      if (ok) this.saved = offset
      this.nextSaveAt = Date.now() + SAVE_INTERVAL
      if (!this.dead) this.saveError = ok ? '' : '进度保存失败，点此重试'
      this.scheduleSave()
    })
  }
}
</script>

<style>
.page { width: 100%; height: 100%; padding: 8px; flex-direction: column; background-color: #000000; }
.header { position: absolute; top: 8px; left: 8px; right: 8px; height: 56px; padding: 0px 30px; align-items: center; background-color: #000000; flex-shrink: 0; }
.back { width: 30px; height: 30px; line-height: 20px; margin-right: 2px; font-size: 34px; font-weight: normal; text-align: center; lines: 1; flex-shrink: 0; }
.title { flex: 1; font-size: 22px; text-align: center; lines: 1; text-overflow: ellipsis; }
.header-text { color: #929292; }
.reading { width: 100%; height: 100%; padding: 2px 16px; flex-direction: column; flex-shrink: 0; }
.line { width: 100%; height: 43px; line-height: 43px; font-size: 20px; color: #dedede; lines: 1; flex-shrink: 0; }
.footer { position: absolute; bottom: 8px; left: 8px; right: 8px; height: 58px; padding: 0px 24px; align-items: center; background-color: #000000; flex-shrink: 0; }
.status { width: 100%; font-size: 16px; line-height: 22px; color: #929292; text-align: center; lines: 2; }
.jump-panel { width: 100%; height: 378px; margin-top: 56px; padding: 16px 12px; flex-direction: column; align-items: center; flex-shrink: 0; }
.jump-label { width: 100%; height: 40px; font-size: 24px; color: #dedede; text-align: center; }
.jump-value { width: 100%; height: 80px; font-size: 40px; color: #f5f5f5; text-align: center; }
.jump-row { width: 100%; height: 72px; justify-content: space-between; align-items: center; flex-shrink: 0; }
.jump-step { width: 80px; height: 56px; background-color: #262629; border-radius: 16px; align-items: center; justify-content: center; }
.jump-action { width: 166px; height: 56px; background-color: #262629; border-radius: 16px; align-items: center; justify-content: center; }
.jump-button-text { font-size: 22px; color: #f5f5f5; lines: 1; }
</style>
