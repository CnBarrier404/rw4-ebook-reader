<template>
  <div class="page">
    <div class="header">
      <div class="back-button" onclick="goBack"><text class="back header-text">&lt;</text></div>
      <text class="title header-text">设置</text>
    </div>
    <div class="setting">
      <text class="label">阅读时保持亮屏</text>
      <switch class="toggle" if="{{!loading && !saving}}" checked="{{keepScreenOn}}" onchange="onKeepScreenOnChange"></switch>
      <text class="value" if="{{loading || saving}}">{{loading ? '读取中' : '保存中'}}</text>
    </div>
    <text class="hint">仅在阅读页保持亮屏，退出阅读后取消。开启会增加耗电。</text>
    <text class="error" if="{{error}}">{{error}}</text>
  </div>
</template>

<script>
import router from '@system.router'
import { getKeepScreenOn, saveKeepScreenOn } from '../../common/reader-settings'

export default {
  private: { keepScreenOn: false, loading: true, saving: false, error: '' },
  onInit() {
    this.dead = false
    getKeepScreenOn((enabled) => {
      if (this.dead) return
      this.keepScreenOn = enabled
      this.loading = false
    })
  },
  onDestroy() { this.dead = true },
  onKeepScreenOnChange(event) {
    if (this.loading || this.saving || this.dead) return
    const enabled = event.checked
    if (typeof enabled !== 'boolean' || enabled === this.keepScreenOn) return
    this.saving = true
    this.error = ''
    saveKeepScreenOn(enabled, (ok) => {
      if (this.dead) return
      this.saving = false
      if (ok) this.keepScreenOn = enabled
      else this.error = '保存失败，请重新切换开关'
    })
  },
  goBack() { router.back() }
}
</script>

<style>
.page { width: 100%; height: 100%; padding: 8px 8px 32px; flex-direction: column; background-color: #000000; }
.header { width: 100%; height: 56px; padding: 0px 30px; align-items: center; flex-shrink: 0; }
.back-button { width: 48px; height: 48px; align-items: center; justify-content: center; }
.back { width: 30px; height: 30px; line-height: 20px; font-size: 34px; font-weight: normal; text-align: center; lines: 1; }
.title { font-size: 30px; font-weight: normal; margin-left: 2px; lines: 1; }
.header-text { color: #f5f5f5; }
.setting { width: 100%; height: 96px; margin-top: 8px; padding: 20px 22px; border-radius: 22px; background-color: #262629; align-items: center; justify-content: space-between; flex-shrink: 0; }
.label { flex: 1; font-size: 24px; color: #f5f5f5; lines: 1; }
.toggle { width: 70px; height: 42px; margin-left: 12px; flex-shrink: 0; }
.value { width: 70px; margin-left: 12px; font-size: 20px; color: #929292; text-align: center; lines: 1; flex-shrink: 0; }
.hint { width: 100%; padding: 12px 22px; font-size: 22px; line-height: 30px; color: #929292; }
.error { width: 100%; padding: 0px 12px; font-size: 20px; line-height: 28px; color: #ff9999; }
</style>
